{
  "name": "flux-terminal",
  "version": "0.4.0",
  "description": "A vivid terminal for living and reliving your Claude Code sessions",
  "author": "James Collard",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/ensure-electron.cjs",
    "fix-electron": "node scripts/ensure-electron.cjs",
    "smoke": "node scripts/smoke-pty.cjs",
    "smoke:electron": "electron scripts/smoke-pty.cjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.5"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.7",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  }
}
